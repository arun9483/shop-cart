{
  "name": "shop-cart",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "pnpm -r run build",
    "start": "pnpm -r --parallel --filter=./fes --filter=./mock-backend run start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "standalone": "shell-stub --name cart --mfe-url http://localhost:3003 --port 3103",
    "standalone:dev": "shell-stub --name cart --mfe-url http://localhost:3003 --port 3103 --dev"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=11.28.5"
  },
  "devDependencies": {
    "@arun-shop/shell-stub": "0.2.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
