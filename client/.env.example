# Timeouts in ms, read at build time: a slower lazy page shows the fallback, a slower API call fails.
VITE_LAZY_CHUNK_TIMEOUT_MS=5000
VITE_API_TIMEOUT_MS=4000

# Source map upload at build time. Cart errors are reported by the Shell's browser agent, so the
# maps go to the Shell's browser app (its application ID). Placeholders until New Relic is set up.
NEW_RELIC_USER_API_KEY=dummy-new-relic-user-api-key
NEW_RELIC_BROWSER_APP_ID=0000000000
# The public origin the maps are uploaded against: the router locally, the CDN in production.
PUBLIC_ORIGIN=http://localhost:3000
